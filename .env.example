# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/regear

# Cloudinary Configuration for Image Uploads (Optional in local dev; falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key for protected seed trigger in production/staging (Optional)
ADMIN_SEED_SECRET=regear_secret_seed_key_2026
